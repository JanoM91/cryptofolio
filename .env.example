# Exclusivamente servidor. Nunca usar prefijo VITE_ para secretos.
CMC_API_KEY=
PORT=3001
HOST=127.0.0.1
CMC_REQUESTS_PER_MINUTE=25
# Opt-in: cuentas privadas. La copia local no se migra automáticamente.
ACCOUNTS_ENABLED=false
DATABASE_PATH=./data/cryptofolio.sqlite
# Invitación privada de al menos 24 caracteres. Vacío cierra nuevos registros.
REGISTRATION_CODE=
# Producción: origen HTTPS sin barra final y NODE_ENV=production.
# APP_ORIGIN=https://portafolio.ejemplo.com
